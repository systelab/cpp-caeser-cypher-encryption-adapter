def version = "0.0.0"
def packageNameInterface = "caeser-cypher-encryption-adapter"
def profile = "vs2022.conanprofile"
def archs = ['x86', 'x86_64']
def configs = ['Debug', 'Release']


@Library('aid-pipeline-utils@1.0.23') _
   
pipeline
{
	agent
	{
		label 'lib-build'
	}

	environment
	{
		PATH = "${env.USERPROFILE}\\.venvs\\conan2\\Scripts;${env.PATH}"
	}

	parameters
	{
		string(	name: 'tag',
 				description: 'Version to build (must match the version of the tag that will be checked out), leave blank for checkout of current branch',
 				defaultValue: '',
 				trim: true)
 		
 		booleanParam( name: 'uploadPackage',
 					  description: 'Whether or not to upload conan package',
 					  defaultValue: false )
	}

	options
	{
		skipDefaultCheckout(true)
		disableConcurrentBuilds()
		buildDiscarder(logRotator(numToKeepStr: '5'))
	}

	stages
	{
		stage('Checkout')
		{
			steps
			{
				cleanupWorkspace()
 				script 
 				{
 					if (params.tag == '')
 					{
 						checkoutFromGIT()
 					}
 					else
 					{
 						version = params.tag
 						checkoutFromGIT(scm.userRemoteConfigs[0].url, "v${version}", true)
 					}

 				}
			}
		}
		
		stage('Build')
		{	
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							stage("Build ${config}|${arch}")
							{
								def buildFolder = "build/${config}-${arch}"
								bat script: "conan install . --output-folder ${buildFolder} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: 'Installing dependencies'
								bat script: "conan build . --output-folder ${buildFolder} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: 'Building'					
								bat script: "conan export-pkg . --name ${packageNameInterface} --version ${version} --output-folder ${buildFolder} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}", label: "Exporting package ${packageNameInterface}/${version}"
								dir("${buildFolder}/build/bin/${config}/")
								{
									bat "CaeserCypherEncryptionAdapterTest.exe --gtest_output=xml:CaeserCypherEncryptionAdapterTest.xml"
								}
							}
						}
					}
				}
			}
		}

		stage('Test Packages')
		{
			steps
			{
				script
				{
					archs.each
					{ arch ->
						configs.each
						{ config ->
							bat "conan test test_package/conanfile.py ${packageNameInterface}/${version} --profile:all=${profile} -s:a arch=${arch} -s:a build_type=${config}"
						}
					}
				}
			}
		}

		stage('Deploy')
		{
			when
			{
				expression { params.uploadPackage }
			}
			steps
			{
				script
				{
					bat script:"conan upload ${packageNameInterface}/${version} -r aid-conan-production-local --confirm", label: 'Uploading caeser-cypher-encryption-adapter package to Artifactory'
				}
			}
		}
	}
	
	post
	{
		always
		{
			junit allowEmptyResults: true, testResults: "build*/CaeserCypherEncryptionAdapterTest.xml"
			script
 			{
 				currentBuild.description = version
 			}
 			cleanupWorkspace()
		}
	}
}